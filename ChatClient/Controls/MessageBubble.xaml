<UserControl x:Class="ChatClient.Controls.MessageBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40">

    <Grid x:Name="RootGrid">

        <!-- ================================================= -->
        <!-- OTHER USER MESSAGE                                -->
        <!-- ================================================= -->

        <Grid
            x:Name="OtherMessageContainer"
            HorizontalAlignment="Left"
            Margin="0,6,100,6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- AVATAR -->

            <Border
                Grid.Column="0"
                Width="32"
                Height="32"
                Background="#6C4AB6"
                CornerRadius="16"
                VerticalAlignment="Top">

                <TextBlock
                    x:Name="OtherAvatarText"
                    Text="U"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>


            <!-- MESSAGE -->

            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0">

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,4">

                    <TextBlock
                        x:Name="OtherUsernameText"
                        Text="User"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#202225"/>

                    <TextBlock
                        x:Name="OtherTimestampText"
                        Text="12:00"
                        FontSize="10"
                        Foreground="#9CA3AF"
                        Margin="8,1,0,0"/>

                </StackPanel>

                <Border
                    Background="White"
                    CornerRadius="4,16,16,16"
                    Padding="12,9"
                    MaxWidth="500"
                    BorderThickness="1"
                    BorderBrush="#E5E7EB">

                    <TextBlock
                        x:Name="OtherMessageText"
                        Text="Message"
                        FontSize="14"
                        Foreground="#202225"
                        TextWrapping="Wrap"/>

                </Border>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- MY MESSAGE                                         -->
        <!-- ================================================= -->

        <Grid
            x:Name="MyMessageContainer"
            HorizontalAlignment="Right"
            Margin="100,6,0,6"
            Visibility="Collapsed">

            <StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,4">

                    <TextBlock
                        x:Name="MyTimestampText"
                        Text="12:00"
                        FontSize="10"
                        Foreground="#9CA3AF"
                        Margin="0,1,8,0"/>

                    <TextBlock
                        x:Name="MyUsernameText"
                        Text="You"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#202225"/>

                </StackPanel>

                <Border
                    Background="#6C4AB6"
                    CornerRadius="16,4,16,16"
                    Padding="12,9"
                    MaxWidth="500">

                    <TextBlock
                        x:Name="MyMessageText"
                        Text="Message"
                        FontSize="14"
                        Foreground="White"
                        TextWrapping="Wrap"/>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"

        Title="ChatLab"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <Style x:Key="AttachmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0EBFA"/>
            <Setter Property="Foreground" Value="#6541A5"/>
            <Setter Property="BorderBrush" Value="#E2D7F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E6DAF7"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#B99ADC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#6C4AB6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D8C5EF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ================================================= -->
        <!-- MAIN LAYOUT                                       -->
        <!-- ================================================= -->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR                                            -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="#202225">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- APP HEADER -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,30">

                    <TextBlock
                        Text="ChatLab"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Networking Lab 1"
                        Foreground="#8E9297"
                        FontSize="12"
                        Margin="0,4,0,0"/>

                </StackPanel>


                <!-- CHANNEL -->

                <StackPanel Grid.Row="1"
                            Margin="0,0,0,25">

                    <TextBlock
                        Text="CHANNEL"
                        Foreground="#8E9297"
                        FontSize="11"
                        FontWeight="Bold"
                        Margin="0,0,0,8"/>

                    <Border
                        Background="#34373C"
                        CornerRadius="6"
                        Padding="10">

                        <TextBlock
                            Text="General Chat"
                            Foreground="White"
                            FontSize="14"/>

                    </Border>

                </StackPanel>


                <!-- SIDEBAR CONTENT -->

                <ScrollViewer
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- ONLINE -->

                        <TextBlock
                            Text="ONLINE"
                            Foreground="#8E9297"
                            FontSize="11"
                            FontWeight="Bold"
                            Margin="0,0,0,8"/>

                        <!--
                            IMPORTANT:
                            ONLY ONE OnlineUsersPanel
                        -->

                        <StackPanel
                            x:Name="OnlineUsersPanel"
                            Margin="0,0,0,25">

                            <TextBlock
                                Text="Not connected"
                                Foreground="#72767D"
                                FontSize="13"/>

                        </StackPanel>


                        <!-- CURRENT USER -->

                        <TextBlock
                            Text="CURRENT USER"
                            Foreground="#8E9297"
                            FontSize="11"
                            FontWeight="Bold"
                            Margin="0,0,0,8"/>

                        <TextBox
                            x:Name="UsernameTextBox"
                            Text="User"
                            Height="38"
                            Padding="10"
                            Background="#2F3136"
                            Foreground="White"
                            BorderBrush="#40444B"
                            BorderThickness="1"
                            FontSize="13"/>

                    </StackPanel>

                </ScrollViewer>


                <!-- CONNECT / DISCONNECT -->

                <StackPanel Grid.Row="3">

                    <Button
                        x:Name="ConnectButton"
                        Content="Connect"
                        Height="40"
                        Background="#6C4AB6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="ConnectButton_Click"/>

                    <Button
                        x:Name="DisconnectButton"
                        Content="Disconnect"
                        Height="40"
                        Margin="0,8,0,0"
                        Background="#ED4245"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="DisconnectButton_Click"
                        Visibility="Collapsed"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT                                       -->
        <!-- ================================================= -->

        <Grid Grid.Column="1"
              Background="#F5F7FA">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- CHAT HEADER                                        -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                <Grid Margin="25,0">

                    <StackPanel
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="General Chat"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#202225"/>

                        <TextBlock
                            x:Name="StatusTextBlock"
                            Text="Disconnected"
                            Foreground="#72767D"
                            FontSize="12"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CHAT AREA                                          -->
            <!-- ================================================= -->

            <ScrollViewer
                x:Name="ChatScrollViewer"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="25">

                <Grid>

                    <!-- WELCOME -->

                    <StackPanel
                        x:Name="WelcomePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,100,0,100">

                        <TextBlock
                            Text="Welcome to ChatLab"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#202225"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Connect to the server and start chatting."
                            FontSize="14"
                            Foreground="#72767D"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- MESSAGES -->

                    <StackPanel
                        x:Name="ChatPanel"
                        Margin="0,0,0,20"/>

                </Grid>

            </ScrollViewer>


            <!-- ================================================= -->
            <!-- MESSAGE COMPOSER                                   -->
            <!-- ================================================= -->

            <Border
                Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="20,15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Border x:Name="PendingImagePanel" Grid.Row="0" Grid.ColumnSpan="3"
                            Visibility="Collapsed" Background="#F3F4F6" CornerRadius="10"
                            Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="88" Height="80">
                                <Image x:Name="PendingImagePreview" Width="72" Height="72" Stretch="UniformToFill"/>
                                <Button Content="×" Width="24" Height="24" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" ToolTip="Bỏ ảnh đã chọn" Click="RemovePendingImage_Click"/>
                            </Grid>
                            <TextBlock x:Name="PendingImageName" VerticalAlignment="Center" Margin="12,0"
                                       MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ImageButton" Style="{StaticResource AttachmentButtonStyle}"
                                ToolTip="Chọn ảnh để xem trước khi gửi" AutomationProperties.Name="Chọn ảnh"
                                Click="ImageButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M2,2 L18,2 18,18 2,18 Z M2,14 L7,9 11,13 14,10 18,14 M12,6 A1,1 0 1 0 14,6 A1,1 0 1 0 12,6"/>
                                <TextBlock Text="Chọn ảnh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FileButton" Style="{StaticResource AttachmentButtonStyle}"
                                Margin="8,0,0,0" ToolTip="Gửi file lớn đến 10 GB" AutomationProperties.Name="Gửi file"
                                Click="FileButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M4,1 L12,1 17,6 17,19 4,19 Z M12,1 L12,6 17,6 M7,11 L14,11 M7,15 L12,15"/>
                                <TextBlock Text="Gửi file" VerticalAlignment="Center"/>
                                <Border Background="#E2D7F3" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="500 MB+" FontSize="10" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Có thể gửi ảnh khi file đang truyền"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#72767D"/>
                    </StackPanel>

                    <Button
                        Grid.Row="1" x:Name="EmojiButton"
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        Margin="0,0,8,0"
                        Content="😊"
                        FontSize="20"
                        Background="#F3F4F6"
                        BorderThickness="0"
                        Click="EmojiButton_Click"/>


                    <!-- MESSAGE INPUT -->

                    <TextBox
                        Grid.Row="1" x:Name="MessageTextBox"
                        Grid.Column="1"
                        Height="42"
                        Padding="12,10"
                        VerticalContentAlignment="Center"
                        Background="#F3F4F6"
                        BorderThickness="0"
                        FontSize="14"
                        IsEnabled="False"
                        KeyDown="MessageTextBox_KeyDown"/>


                    <!-- SEND BUTTON -->

                    <Button
                        Grid.Row="1" x:Name="SendButton"
                        Grid.Column="2"
                        Width="80"
                        Height="42"
                        Margin="8,0,0,0"
                        Content="Send"
                        Background="#6C4AB6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="SendButton_Click"
                        IsEnabled="False"/>


                    <!-- ================================================= -->
                    <!-- EMOJI POPUP                                         -->
                    <!-- ================================================= -->

                    <Popup
                        x:Name="EmojiPopup"
                        PlacementTarget="{Binding ElementName=EmojiButton}"
                        Placement="Top"
                        StaysOpen="False"
                        AllowsTransparency="True">

                        <Border
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">

                            <WrapPanel x:Name="EmojiChoices" Width="280"/>

                        </Border>

                    </Popup>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
